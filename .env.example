# Backend
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://shodh:shodh@postgres:5432/shodh
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Provider keys, used in later stages
COHERE_API_KEY=
GEMINI_API_KEY=
SHODH_API_KEY=

# Retrieval / application defaults
QDRANT_COLLECTION=shodh_docs
HYBRID_ALPHA=0.7
NEXT_PUBLIC_API_KEY=
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=25
