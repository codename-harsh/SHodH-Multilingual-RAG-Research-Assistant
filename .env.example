# Shodh local development settings
# Copy to .env, then run: docker compose up --build

# Required by the local PostgreSQL container. This sample is URL-safe and is
# only for local development; use a private value outside your workstation.
POSTGRES_PASSWORD=shodh-local-only-change-me
POSTGRES_USER=shodh
POSTGRES_DB=shodh
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Optional full SQLAlchemy URL override. Leave blank to build a URL safely from
# the PostgreSQL values above. For a managed database, provide its full URL.
DATABASE_URL=

# Compose service addresses. Keep these defaults for the bundled containers.
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=shodh_docs

# Optional provider credentials. The stack starts without them. Ingestion
# requires Cohere; grounded queries require Cohere and Gemini; RAGAS evaluation
# requires both keys and a completed, real golden dataset.
COHERE_API_KEY=
GEMINI_API_KEY=

# Provider model identifiers; defaults shown are the settings defaults.
COHERE_EMBED_MODEL=embed-multilingual-v3.0
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EVAL_MODEL=gemini-2.0-flash
GEMINI_EVAL_EMBED_MODEL=models/text-embedding-004

# Development API-key gate. Leave empty for a private local-only demo.
# This is one shared key, not user authentication or tenant isolation.
SHODH_API_KEY=
APP_ENV=development
SHODH_API_URL=http://localhost:8000

# Retrieval and ingestion settings.
HYBRID_ALPHA=0.7
CHUNK_SIZE=512
CHUNK_OVERLAP=128
EMBED_BATCH_SIZE=96
MAX_UPLOAD_MB=25

# Comma-separated browser origins allowed by FastAPI.
CORS_ORIGINS=http://localhost:3000

# Browser-visible settings. Never put a secret in a NEXT_PUBLIC_* variable.
# NEXT_PUBLIC_API_URL is baked into the frontend during its Docker build.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set true only when SHODH_API_KEY is set in the backend environment.
NEXT_PUBLIC_REQUIRE_API_KEY=false
