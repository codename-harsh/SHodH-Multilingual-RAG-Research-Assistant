# Backend
APP_ENV=development
POSTGRES_PASSWORD=replace-with-a-strong-local-password
# Optional override; when unset Compose builds this from POSTGRES_PASSWORD.
# DATABASE_URL=postgresql+asyncpg://shodh:replace-me@postgres:5432/shodh
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public UI toggle; the API key itself remains backend-only.
NEXT_PUBLIC_REQUIRE_API_KEY=false

# Provider keys, used in later stages
COHERE_API_KEY=
GEMINI_API_KEY=
SHODH_API_KEY=

# Retrieval / application defaults
QDRANT_COLLECTION=shodh_docs
HYBRID_ALPHA=0.7
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=25
